APP_ENV=development
APP_NAME=FlashFlood API
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173"]

WEATHER_UPSTREAM_LATITUDE=26.31393
WEATHER_UPSTREAM_LONGITUDE=94.51675

WEATHER_DOWNSTREAM_LATITUDE=27.0280
WEATHER_DOWNSTREAM_LONGITUDE=95.0312

WEATHER_FORECAST_HORIZON_HOURS=6
WEATHER_TIMEOUT_SECONDS=5
WEATHER_CACHE_TTL_SECONDS=60

# Optional WeatherAPI fallback. Keep the API key backend-only.
WEATHERAPI_ENABLED=false
WEATHERAPI_API_KEY=

# Firestore persistence is opt-in for local development.
FIRESTORE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=

# Firebase Cloud Messaging is opt-in and uses real Firebase infrastructure.
FCM_ENABLED=false

# Stage 12 prototype communication features are local simulations and disabled by default.
# Free local SMS portfolio mode works in process memory when Firestore and FCM are disabled.
# Local SMS demo state resets when the backend process restarts.
SMS_SIMULATOR_ENABLED=false
EMERGENCY_REPORTING_ENABLED=false
