VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_REFRESH_INTERVAL_MS=60000

# Browser push alerts are optional and disabled by default.
# These Firebase Web values are public app configuration, not Admin credentials.
VITE_FCM_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Stage 12 prototype communication panels are disabled by default.
VITE_SMS_SIMULATOR_ENABLED=false
VITE_EMERGENCY_REPORTING_ENABLED=True